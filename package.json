{
	"name": "boilerplate.ts",
	"version": "5.4.13",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"generate-api-specs": "npx openapi-typescript https://api.klickrhein.de/v6/openapi.yaml -o ./src/lib/boilerplate/xioni/api/api.d.ts --make-paths-enum --root-types",
		"postinstall": "npm run generate-api-specs",
		"update": "npx npm-check-updates",
		"version:prerelease": "npm version prerelease --no-git-tag-version",
		"version:patch": "npm version patch --no-git-tag-version",
		"version:minor": "npm version minor --no-git-tag-version",
		"version:major": "npm version major --no-git-tag-version"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/eslint": "9.6.1",
		"@types/node": "26",
		"@typescript-eslint/eslint-plugin": "8.69.0",
		"@typescript-eslint/parser": "8.69.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"eslint": "10.10.0",
		"globals": "17.12.0",
		"openapi-typescript": "7.13.0",
		"prettier-plugin-svelte": "4.1.1",
		"prettier": "3.9.6",
		"sass": "1.104.0",
		"svelte-check": "4.7.6",
		"svelte": "5.57.0",
		"sveltekit-autoimport": "1.8.2",
		"tslib": "2.8.1",
		"typescript-eslint": "8.69.0",
		"typescript": "5.9.3",
		"vite": "8.2.2"
	},
	"type": "module",
	"dependencies": {
		"@glidejs/glide": "3.7.1",
		"@types/glidejs__glide": "3.6.6",
		"@types/lodash-es": "4.17.12",
		"date-fns": "4.4.0",
		"lodash-es": "4.18.1",
		"openapi-fetch": "0.17.0",
		"openapi-typescript-fetch": "2.2.1",
		"opening_hours": "3.14.0",
		"svelte": "5.57.0",
		"svelte-preprocess": "6.0.5"
	}
}
